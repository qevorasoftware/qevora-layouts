{
  "$schema": "qevora-layouts/template/v1",
  "id": "qevora-header-centered",
  "name": "Centered Header",
  "description": "Logo, site title, tagline and navigation stacked and centered. Includes the front page only, so it demonstrates how a more specific condition overrides the simple header.",
  "type": "header",
  "builder": "block",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"28px\",\"right\":\"24px\",\"bottom\":\"20px\",\"left\":\"24px\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:28px;padding-right:24px;padding-bottom:20px;padding-left:24px\"><!-- wp:site-logo {\"width\":56,\"align\":\"center\",\"shouldSyncIcon\":true} /-->\n\n<!-- wp:site-title {\"level\":1,\"textAlign\":\"center\"} /-->\n\n<!-- wp:site-tagline {\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} /-->\n\n<!-- wp:navigation {\"overlayMenu\":\"mobile\",\"layout\":{\"type\":\"flex\",\"setCascadingProperties\":true,\"justifyContent\":\"center\",\"orientation\":\"horizontal\"}} /--></div>\n<!-- /wp:group -->\n",
  "conditions": {
    "include": [
      {
        "type": "front_page"
      }
    ],
    "exclude": []
  },
  "priority": 20,
  "placement": "wp_body_open",
  "preview": "assets/images/previews/header-centered.svg",
  "tags": [
    "header",
    "centered",
    "front-page"
  ],
  "requires": {
    "wordpress": "6.4",
    "php": "7.4"
  },
  "version": "1.0.0",
  "author": "Qevora Software",
  "license": "GPL-2.0-or-later"
}
