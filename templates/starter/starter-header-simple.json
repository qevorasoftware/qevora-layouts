{
  "$schema": "qevora-layouts/template/v1",
  "id": "qevora-header-simple",
  "name": "Simple Header",
  "description": "A full-width header row with the site logo, site title and the core navigation block. Built from WordPress core blocks only, so it works without a page builder.",
  "type": "header",
  "builder": "block",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"16px\",\"right\":\"24px\",\"bottom\":\"16px\",\"left\":\"24px\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:16px;padding-right:24px;padding-bottom:16px;padding-left:24px\"><!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:site-logo {\"width\":42,\"shouldSyncIcon\":true} /-->\n\n<!-- wp:site-title {\"level\":1} /--></div>\n<!-- /wp:group -->\n\n<!-- wp:navigation {\"overlayMenu\":\"mobile\",\"layout\":{\"type\":\"flex\",\"setCascadingProperties\":true,\"justifyContent\":\"right\",\"orientation\":\"horizontal\"}} /--></div>\n<!-- /wp:group -->\n",
  "conditions": {
    "include": [],
    "exclude": []
  },
  "priority": 10,
  "placement": "wp_body_open",
  "preview": "assets/images/previews/header-simple.svg",
  "tags": [
    "header",
    "minimal",
    "core-blocks"
  ],
  "requires": {
    "wordpress": "6.4",
    "php": "7.4"
  },
  "version": "1.0.0",
