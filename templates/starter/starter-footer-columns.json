{
  "$schema": "qevora-layouts/template/v1",
  "id": "qevora-footer-columns",
  "name": "Footer with Columns",
  "description": "A four-column footer: about text, two link lists and the latest posts, closed by a separator and a copyright line. Core blocks only.",
  "type": "footer",
  "builder": "block",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#f6f7f7\"},\"spacing\":{\"padding\":{\"top\":\"48px\",\"right\":\"24px\",\"bottom\":\"24px\",\"left\":\"24px\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#f6f7f7;padding-top:48px;padding-right:24px;padding-bottom:24px;padding-left:24px\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:site-title {\"level\":2} /-->\n\n<!-- wp:site-tagline {\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} /-->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} -->\n<p style=\"font-size:14px\">One or two sentences about your site, your opening hours or your support channels.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"15px\"}}} -->\n<h3 class=\"wp-block-heading\" style=\"font-size:15px\">Explore</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} -->\n<ul style=\"font-size:14px\"><!-- wp:list-item -->\n<li><a href=\"#\">About</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#\">Services</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#\">Contact</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"15px\"}}} -->\n<h3 class=\"wp-block-heading\" style=\"font-size:15px\">Legal</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} -->\n<ul style=\"font-size:14px\"><!-- wp:list-item -->\n<li><a href=\"#\">Privacy policy</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#\">Terms of use</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"#\">Imprint</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"15px\"}}} -->\n<h3 class=\"wp-block-heading\" style=\"font-size:15px\">Latest posts</h3>\n<!-- /wp:heading -->\n\n<!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"style\":{\"typography\":{\"fontSize\":\"14px\"}}} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:separator {\"backgroundColor\":\"contrast\",\"className\":\"is-style-wide\"} -->\n<hr class=\"wp-block-separator has-text-color has-contrast-color has-alpha-channel-opacity has-contrast-background-color has-background is-style-wide\"/>\n<!-- /wp:separator -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"13px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:13px\">Replace this line with your own copyright notice.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n",
  "conditions": {
    "include": [],
    "exclude": []
  },
  "priority": 10,
  "placement": "get_footer",
  "preview": "assets/images/previews/footer-columns.svg",
