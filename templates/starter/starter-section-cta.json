{
  "$schema": "qevora-layouts/template/v1",
  "id": "qevora-section-cta",
  "name": "Call to Action Section",
  "description": "A coloured call-to-action block with a heading, one sentence and two buttons. Insert it anywhere with the Qevora Layout block or the [qevora_layout] shortcode.",
  "type": "section",
  "builder": "block",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#2271b1\",\"text\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"56px\",\"right\":\"24px\",\"bottom\":\"56px\",\"left\":\"24px\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-text-color has-background\" style=\"color:#ffffff;background-color:#2271b1;padding-top:56px;padding-right:24px;padding-bottom:56px;padding-left:24px\"><!-- wp:heading {\"textAlign\":\"center\",\"level\":2,\"style\":{\"typography\":{\"fontSize\":\"36px\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\" style=\"font-size:36px\">A reusable call to action</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"17px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:17px\">Insert this section anywhere with the Qevora Layout block or the [qevora_layout] shortcode, and edit it once for every page that uses it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"white\",\"textColor\":\"vivid-cyan-blue\"} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-vivid-cyan-blue-color has-white-background-color has-text-color has-background wp-element-button\" href=\"#\">Primary action</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">Learn more</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n",
  "conditions": {
    "include": [],
    "exclude": []
  },
  "priority": 10,
  "placement": "manual",
  "preview": "assets/images/previews/section-cta.svg",
  "tags": [
    "section",
    "cta",
    "reusable"
  ],
  "requires": {
    "wordpress": "6.4",
    "php": "7.4"
  },
  "version": "1.0.0",
  "author": "Qevora Software",
  "license": "GPL-2.0-or-later"
}
