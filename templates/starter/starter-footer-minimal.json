{
  "$schema": "qevora-layouts/template/v1",
  "id": "qevora-footer-minimal",
  "name": "Minimal Footer",
  "description": "A single-line footer with copyright, legal links and a back-to-top link. Included on singular content only, so it overrides the column footer there.",
  "type": "footer",
  "builder": "block",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"24px\",\"bottom\":\"20px\",\"left\":\"24px\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:20px;padding-right:24px;padding-bottom:20px;padding-left:24px\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\"}}} -->\n<p style=\"font-size:13px\">Replace this line with your own copyright notice.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\"}}} -->\n<p style=\"font-size:13px\"><a href=\"#\">Privacy</a> · <a href=\"#\">Terms</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\"}}} -->\n<p style=\"font-size:13px\"><a href=\"#\">Back to top</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n",
  "conditions": {
    "include": [
      {
        "type": "singular"
      }
    ],
    "exclude": []
  },
  "priority": 20,
  "placement": "get_footer",
  "preview": "assets/images/previews/footer-minimal.svg",
  "tags": [
    "footer",
    "minimal"
  ],
  "requires": {
    "wordpress": "6.4",
    "php": "7.4"
  },
  "version": "1.0.0",
  "author": "Qevora Software",
  "license": "GPL-2.0-or-later"
}
